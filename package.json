{
  "name": "drops-agent",
  "version": "2.1.0",
  "description": "DROPs - autonomous AI coding agent for Windows",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable zip",
    "check": "node scripts/check.js",
    "icon": "electron scripts/make-icon.js",
    "test": "node --test tests/guards.test.js tests/features.test.js tests/muse-glimmer.test.js tests/security.test.js tests/capabilities.test.js tests/media-workers.test.js tests/lessons.test.js tests/browser.test.js tests/fallback.test.js tests/brand.test.js tests/hardening.test.js tests/tasks.test.js",
    "bench": "node bench/run.js",
    "headless": "node src/cli.js",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "test:ui": "node --test tests/ui.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@google/genai": "^3.3.0",
    "@highlightjs/cdn-assets": "^11.12.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "diff": "^9.0.0",
    "dompurify": "^3.4.17",
    "fast-glob": "^3.3.3",
    "marked": "^18.2.0",
    "monaco-editor": "^0.57.0",
    "openai": "^7.57.0",
    "pdfjs-dist": "6.4.299",
    "playwright-core": "1.64.1"
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2"
  },
  "productName": "DROPs",
  "build": {
    "appId": "dev.drops.agent",
    "productName": "DROPs",
    "files": [
      "src/**/*",
      "node_modules/**/*",
      "package.json",
      "!node_modules/typescript/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable",
        "zip"
      ],
      "icon": "src/assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.exe"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "src/assets/icon.png",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "src/assets/icon.png",
      "category": "Development"
    }
  },
  "bin": {
    "drops": "src/cli.js",
    "h2o": "src/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Clipping771/DROPs.git"
  }
}
